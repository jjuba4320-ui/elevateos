{
  "expo": {
    "name": "مَداك | MadakOS",
    "slug": "madakos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./public/logo.svg",
    "scheme": "madakos",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./public/logo.svg",
      "resizeMode": "contain",
      "backgroundColor": "#0b0d1e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madak.os",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/logo.svg",
        "backgroundColor": "#0b0d1e"
      },
      "package": "com.madak.os",
      "versionCode": 1,
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./public/favicon.svg",
      "bundler": "metro"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
